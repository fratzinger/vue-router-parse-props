{
  "name": "vue-router-parse-props",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@12.4.2",
  "description": "Parse params and query in vue-router to component props.",
  "author": "Frederik Schmatz",
  "license": "MIT",
  "homepage": "https://github.com/fratzinger/vue-router-parse-props#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fratzinger/vue-router-parse-props.git"
  },
  "bugs": {
    "url": "https://github.com/fratzinger/vue-router-parse-props/issues"
  },
  "keywords": [
    "vue",
    "vue-router",
    "parse",
    "params",
    "query",
    "props"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist/**",
    "src/**"
  ],
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "tsdown",
    "version": "npm run build",
    "release": "np",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "peerDependencies": {
    "vue": "^3.2.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "date-fns": "^4.4.0",
    "eslint": "^10.10.0",
    "np": "^12.1.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  }
}
